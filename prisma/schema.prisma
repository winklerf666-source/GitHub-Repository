generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGEMENT
  EMPLOYEE
}

enum ContactType {
  BUYER
  SELLER
  LANDLORD
  TENANT
  OTHER
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
  OTHER
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  RENTED
  ARCHIVED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  employee     Employee?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phone       String?
  active      Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id])
  contacts    Contact[]
  properties  Property[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Contact {
  id          String      @id @default(cuid())
  type        ContactType @default(OTHER)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  notes       String?
  employeeName String      @default("Nicht zugewiesen")
  employeeId  String?
  employee    Employee?   @relation(fields: [employeeId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([lastName, firstName])
  @@index([email])
}

model Property {
  id           String         @id @default(cuid())
  title        String
  propertyType PropertyType   @default(APARTMENT)
  status       PropertyStatus @default(DRAFT)
  description  String?
  street       String?
  postalCode   String?
  city         String?
  price        Decimal?       @db.Decimal(12, 2)
  livingArea   Decimal?       @db.Decimal(10, 2)
  rooms        Decimal?       @db.Decimal(4, 1)
  employeeId   String?
  employee     Employee?      @relation(fields: [employeeId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([status])
  @@index([city])
}
